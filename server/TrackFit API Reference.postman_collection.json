      "name": "Authentication",
      "item": [
        {
          "name": "Member Auth",
          "item": [
            {
              "name": "Member Register",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 201) {\r",
                      "  const data = pm.response.json().data;\r",
                      "  pm.environment.set(\"memberToken\", data.accessToken);\r",
                      "  pm.environment.set(\"memberRefreshToken\", data.refreshToken);\r",
                      "  pm.environment.set(\"memberId\", data.user._id);\r",
                      "  pm.environment.set(\"memberEmail\", data.user.email);\r",
                      "\r",
                      "  console.log(\"✅ Member Registered!\");\r",
                      "  console.log(\"ID: \" + data.user._id);\r",
                      "  console.log(\"Trainer ID: \" + pm.environment.get(\"trainerId\"));\r",
                      "} else {\r",
                      "  const error = pm.response.json();\r",
                      "  console.log(\"❌ Error: \" + error.message);\r",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n  \"name\": \"Member03\",\r\n  \"email\": \"member03@example.com\",\r\n  \"password\": \"SecurePassword123\",\r\n  \"role\": \"member\",\r\n  \"trainerId\": \"{{trainerId}}\"\r\n \r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseURL}}/api/auth/register",
                  "host": [
                    "{{baseURL}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "register"
                  ]
                }
              },
              "response": []
            },
            {
              "name": "Member Login",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {\r",
                      "  const data = pm.response.json().data;\r",
                      "  const role = data.user.role;\r",
                      "\r",
                      "    pm.environment.set(\"memberToken\", data.accessToken);\r",
                      "    pm.environment.set(\"memberRefreshToken\", data.refreshToken);\r",
                      "    console.log(\"✅ Member Logged In!\");\r",
                      "\r",
                      "  console.log(\"User: \" + data.user.name);\r",
                      "  console.log(\"Role: \" + role);\r",
                      "} else {\r",
                      "  console.log(\"❌ Login Failed\");\r",
                      "}"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
                "body": {
                  "mode": "raw",
                  "raw": "{\r\n    \"email\": \"member01@example.com\",\r\n    \"password\": \"SecurePassword123\"\r\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseURL}}/api/auth/login",
                  "host": [
                    "{{baseURL}}"
                  ],
                  "path": [
                    "api",
                    "auth",
                    "login"
                  ]
                }
              },
              "response": []
            }
          ]
